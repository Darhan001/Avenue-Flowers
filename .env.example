# Скопируйте в .env и заполните. Файл .env не должен попадать в git.

# Порт HTTP-сервера
PORT=3000

# Публичный адрес сайта (нужен для sitemap.xml, robots.txt и canonical)
SITE_URL=http://localhost:3000

# Telegram-бот для заявок. Токен получить у @BotFather, chat_id — у вашего чата/группы.
TG_TOKEN=
TG_CHAT_ID=

# Число прокси перед сервером (Render — 1, локально без прокси — 0)
TRUST_PROXY=0

# Код подтверждения Google Search Console (значение content из метатега)
GOOGLE_SITE_VERIFICATION=
